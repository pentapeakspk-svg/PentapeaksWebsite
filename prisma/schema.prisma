generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Counter table for atomic rollNo generation (avoids concurrent rollNo collisions)
model RollNoCounter {
  batchId String @id
  counter Int    @default(0)

  @@map("RollNoCounter")
}

model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  password                 String
  plainPassword            String?   // Stores plain text password for admin panel lookup
  role                     Role      @default(STUDENT)
  emailVerified            Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpiry  DateTime?
  student                  Student?
  createdAt                DateTime  @default(now())
}

enum Role {
  STUDENT
  ADMIN
}

model Batch {
  id          String       @id @default(cuid())
  batchNo     String       @unique
  title       String
  description String?
  status      BatchStatus  @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  schedule    String?
  hidden      Boolean      @default(false)
  students    Student[]
  attendances Attendance[]
  classLinks  ClassLink[]
  classRecordings ClassRecording[]
  enrollments BatchEnrollment[]
  fee         Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum BatchStatus {
  ACTIVE
  UPCOMING
  COMPLETED
}

model Student {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  rollNo         String?        @unique
  phone          String
  city           String
  education      String?
  enrollmentType EnrollmentType
  batchId        String?
  batch          Batch?         @relation(fields: [batchId], references: [id])
  enrollments    BatchEnrollment[]
  paid           Boolean        @default(false)
  blocked        Boolean        @default(false)
  attendances    Attendance[]
  isRead         Boolean        @default(false)
  createdAt      DateTime       @default(now())
}

enum EnrollmentType {
  MENTORSHIP
  BATCH
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  batchId   String
  batch     Batch            @relation(fields: [batchId], references: [id])
  date      DateTime         @default(now())
  status    AttendanceStatus
  lectureNo Int?

  @@unique([studentId, batchId, lectureNo])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model ClassLink {
  id      String   @id @default(cuid())
  batchId String
  batch   Batch    @relation(fields: [batchId], references: [id])
  link        String
  title       String
  note        String?
  attachments String[]
  sentAt      DateTime @default(now())
}

model Supplier {
  id             String   @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String
  phone          String
  country        String
  products       String
  exportCapacity String
  certifications String?
  message        String?
  createdAt      DateTime @default(now())
}

model BuyerInquiry {
  id           String   @id @default(cuid())
  buyerName    String
  companyName  String?
  email        String
  phone        String
  country      String
  product      String
  quantity     String
  unit         String
  deliveryPort String?
  paymentTerms String?
  targetPrice  String?
  message      String?
  createdAt      DateTime @default(now())
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String
  content    String
  coverImage String?
  author     String   @default("Penta Peaks Team")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ClassRecording {
  id      String   @id @default(cuid())
  batchId String
  batch   Batch    @relation(fields: [batchId], references: [id])
  link        String
  title       String
  note        String?
  attachments String[]
  sentAt      DateTime @default(now())
}

model BatchEnrollment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paid      Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([studentId, batchId])
}

model DemoClassConfig {
  id           String   @id @default("1")
  isActive     Boolean  @default(false)
  heading      String
  details      String
  detailsRoman String?  @default("")
  detailsUrdu  String?  @default("")
  whatsappLink String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DemoClassEnrollment {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  address   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  title     String
  driveUrl  String
  createdAt DateTime @default(now())
}
