# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pentapeaks"

# Supabase (only required if this project is migrated to Supabase client/server helpers)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Email (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@pentapeaks.com"

# Optional: For production
# VERCEL_URL="your-production-domain.com"

# AI psychiatric counselor agent Groq API Key (Retrieve from Groq Console)
GROQ_API_KEY=""

# Resend (Email verification)
RESEND_API_KEY="re_your_resend_api_key_here"

