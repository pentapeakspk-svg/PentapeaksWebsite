# .env.production.example
# Copy this to .env (or .env.production) on your VPS

# Node Environment
NODE_ENV="production"
PORT="3000"

# Database (PostgreSQL on the VPS)
# Use the URL output from vps-db-setup.sh
DATABASE_URL="postgresql://pentapeaks_user:YOUR_SECURE_PASSWORD@localhost:5432/pentapeaks"

# NextAuth
# MUST be your actual domain in production (e.g., https://pentapeaks.com)
NEXTAUTH_URL="https://yourdomain.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-secret-key-here"

# Admin Access
ADMIN_USERNAME="admin@pentapeaks.com"
ADMINPASSWORD="secure_admin_password_here"

# Email (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@pentapeaks.com"

# Resend (Email verification)
RESEND_API_KEY="re_your_resend_api_key_here"

# AI psychiatric counselor agent Groq API Key (Retrieve from Groq Console)
GROQ_API_KEY="your_groq_api_key_here"
